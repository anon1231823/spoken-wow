{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    // The zones pipeline is dependency-free ESM with no build step, and lib/zones/tools.ts
    // imports it directly rather than shelling out - see the header there. TypeScript reads
    // those modules and infers their shapes, which is what makes a change in pipelines/zones
    // show up as a type error rather than as undefined at runtime.
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      "@tools/*": ["../../pipelines/zones/tools/*"],
      "@books-tools/*": ["../../pipelines/books/tools/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
