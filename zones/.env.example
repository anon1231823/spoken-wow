# ElevenLabs credentials for tools/voice/generate.mjs.
# Copy to .env (gitignored) and fill in. The same account and the same
# narrator-male voice as ../wow-voiceover.
ELEVENLABS_API_KEY=

# The voiceline explorer's database. Unset, tools/voice/* fall back to reading and
# writing tools/voice/manifest.json directly, which is all the addon build needs --
# so a clone with no Postgres can still generate audio and package the addon.
#
# 5433, not 5432: ../wow-voiceover's postgres already holds 5432.
DATABASE_URL=postgres://zonelore:zonelore@localhost:5433/zonelore
