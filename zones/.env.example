# ElevenLabs credentials for tools/voice/generate.mjs.
# Copy to .env (gitignored) and fill in. The same account and the same
# narrator-male voice as ../wow-voiceover.
ELEVENLABS_API_KEY=

# The voiceline explorer's database. Unset, tools/voice/* fall back to reading and
# writing tools/voice/manifest.json directly, which is all the addon build needs --
# so a clone with no Postgres can still generate audio and package the addon.
#
# 5433, not 5432: ../wow-voiceover's postgres already holds 5432. On the droplet the
# cluster is on its default 5432 -- see deploy/README.md.
DATABASE_URL=postgres://zonelore:zonelore@localhost:5433/zonelore

# The explorer's accounts (BETTER_AUTH_SECRET, BETTER_AUTH_URL) are not listed here,
# because `next dev` runs inside web/ and would not read this file anyway. Locally both
# have working defaults -- see the comment in web/src/lib/auth.ts -- and in production
# both are required and live in the droplet's shared/app.env. deploy/README.md has them.
#
# Registering grants no permissions, by design. Promote your local account by hand:
#   docker compose exec postgres psql -U zonelore \
#     -c "update \"user\" set role = 'admin' where email = 'you@example.com'"

# Nothing below is set locally, and setting any of it here would be a mistake.
#
# Every path under tools/ derives from ROOT in tools/lib/loredata.mjs, which is the
# module's own location -- correct for a script, and impossible once webpack has
# compiled it, because webpack replaces import.meta.url at build time. So the deployed
# explorer is told where its files are instead. These are the five, listed here so
# they are discoverable from the same place as everything else:
#
#   ZONELORE_ROOT           the repo root: lore corpus and tools/voice/config.json
#   ZONELORE_SOUNDS         the audio store
#   ZONELORE_AUDIO_HISTORY  superseded takes
#   ZONELORE_MANIFEST       tools/voice/manifest.json
#   ZONELORE_PRONUNCIATION  tools/voice/pronunciation.json
#
# Unset, each falls back to exactly the path it always had. deploy/ecosystem.config.js
# is the only place they are set, and deploy/README.md explains the split between the
# ones that live in a release and the ones that must not.
