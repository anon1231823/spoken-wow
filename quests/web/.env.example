# Copy to .env.local for development. `docker compose up -d postgres` from the repo root
# starts a database matching this URL.
DATABASE_URL=postgres://voiceover:voiceover@127.0.0.1:5432/voiceover

# Signs session cookies. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=dev-secret-change-me

# The public origin. nginx terminates TLS in production, so without this Better Auth would
# build cookies and redirects from http://127.0.0.1:3000.
BETTER_AUTH_URL=http://localhost:3000

# Reads the voice roster, creates clones on /voices, and generates every voiceline. Without
# it /voices still renders and reports the failure, and Regenerate is refused with the reason.
ELEVENLABS_API_KEY=

# Only needed to point the explorer at a corpus, audio store or clip directory outside the
# repo; they default to ../corpus, ../audio, ../voice/samples, ../audio-history and ../voice.
# See src/lib/paths.ts.
#
# VOICEOVER_AUDIO_HISTORY holds previous takes of regenerated lines, one directory per file.
# Version 0 of each is the audio that predated this app, which nothing can reproduce - so in
# production it must point somewhere that survives a deploy.
#
# VOICEOVER_VOICE_CONFIG is the directory holding generation.json and pronunciation.json.
# Without it the app uses built-in defaults and applies no pronunciation rules, so "Hm" is
# read aloud as the letters H and M.
# VOICEOVER_CORPUS=
# VOICEOVER_AUDIO=
# VOICEOVER_VOICE_SAMPLES=
# VOICEOVER_AUDIO_HISTORY=
# VOICEOVER_VOICE_CONFIG=

# Points the ElevenLabs client at a stub, so the clone path can be exercised without
# spending a voice slot. Unset in normal use.
# ELEVENLABS_BASE_URL=
